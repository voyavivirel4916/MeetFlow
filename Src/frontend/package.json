{
  "name": "meetflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "check:browser": "node browser.check.mjs",
    "check:delivery": "node browser.check.mjs --built",
    "check:auth": "node browser.check.mjs --built --auth",
    "check:auth-ui": "node browser.check.mjs --built --auth-ui",
    "check:groups": "node browser.check.mjs --built --groups",
    "check:groups-ui": "node browser.check.mjs --built --groups-ui",
    "check:polls": "node browser.check.mjs --built --polls",
    "check:poll-editor": "node browser.check.mjs --built --poll-editor",
    "check:votes-ui": "node browser.check.mjs --built --votes-ui",
    "check:matrix-ui": "node browser.check.mjs --built --matrix-ui",
    "check:recommendations-ui": "node browser.check.mjs --built --recommendations-ui",
    "check:confirmation-ui": "node browser.check.mjs --built --confirmation-ui",
    "check:meeting-ui": "node browser.check.mjs --built --meeting-ui",
    "check:tasks-ui": "node browser.check.mjs --built --tasks-ui"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
