# Optional local configuration. Defaults work without copying this file.
# Defaults remain loopback-only. Public deployment requires explicit production settings.
MEETFLOW_APP_ENV=local
MEETFLOW_BIND_HOST=127.0.0.1
MEETFLOW_PORT=8000
MEETFLOW_LOG_LEVEL=INFO
# Relative paths are resolved from Src/backend, independent of the current shell.
MEETFLOW_DATA_DIR=data
MEETFLOW_FRONTEND_DIR=../frontend/dist

# Production template only: keep commented for local use. Use a PRIVATE .env on the host.
# MEETFLOW_APP_ENV=production
# MEETFLOW_PUBLIC_ORIGIN=https://meetflow.example.com
# MEETFLOW_DATA_DIR=/private/meetflow-data
# MEETFLOW_BIND_HOST=127.0.0.1
# Proxy peers must come from the hosting provider; never use wildcard trust.
# MEETFLOW_TRUSTED_PROXIES=["127.0.0.1"]
# Password reset stays unavailable until a real SMTP account is configured.
# SMTP transport uses certificate-verified TLS (SMTP_SSL).
# MEETFLOW_SMTP_HOST=smtp.example.com
# MEETFLOW_SMTP_PORT=465
# MEETFLOW_SMTP_USERNAME=sender@example.com
# MEETFLOW_SMTP_PASSWORD=replace-only-in-private-env
# MEETFLOW_SMTP_SENDER=sender@example.com
