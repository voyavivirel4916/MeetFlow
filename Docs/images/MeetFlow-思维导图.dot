digraph MeetFlowMindMap {
  graph [rankdir=LR, bgcolor="#f3f6fb"];
  node [shape=box, style="rounded,filled", fillcolor="white", fontname="Microsoft YaHei"];
  root [label="MeetFlow（凑时）"];
  branch0 [label="用户与权限\n负责人：排期、确认、纪要、指派\n普通成员：本人填写、任务进度\n组内可见，服务端验证对象归属"];
  root -> branch0;
  branch1 [label="排期与推荐\n候选时间、必到成员、三态填写\n发布后冻结，截止后禁止提交\n时间矩阵、稳定排序、冲突解释"];
  root -> branch1;
  branch2 [label="会议与任务\n唯一确认、风险警告与选择理由\n纯文本议程与纪要\n任务列表、执行人、截止与三态"];
  root -> branch2;
  branch3 [label="本地运行与验收\nVue + FastAPI + SQLite\n桌面单实例，20人、15时段\n四账号闭环、权限、并发与恢复"];
  root -> branch3;
  branch4 [label="两人协作\n马若曦：统筹、主要开发、集成\n陈明强：填写页、结果页、汇报\n36项任务，验证后提交并双端同步"];
  root -> branch4;
  branch5 [label="边界与后续\nP1可选：本人首页汇总\n公开部署与真实反馈：后续交付\n手机、统计图、提醒、看板：不纳入"];
  root -> branch5;
}
